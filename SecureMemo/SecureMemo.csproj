<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SecureMemo</RootNamespace>
    <AssemblyName>SecureMemo</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <!-- NU1903 on AutoMapper is GHSA-rvv3-g6hj-g44x, a license-change notice (not a code vulnerability) for versions after the MIT-licensed 14.0.0; see the AutoMapper PackageReference comment below. -->
    <NoWarn>$(NoWarn);WFO1000;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Dotfuscated\**" />
    <Compile Remove="Dotfuscated\**" />
    <!-- Orphaned file, never part of the old project's explicit Compile list; superseded by TextSearchModels/TabSearchEngine.cs -->
    <Compile Remove="Services\TabSearchEngineService.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.4" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageReference Include="AutofacSerilogIntegration" Version="5.0.0" />
    <!-- Pinned at 14.0.0: the last MIT-licensed release. 15.0.0+ moved to a commercial/dual license (verified via nuspec: license type flips from "MIT" expression to a bundled LICENSE.md file with requireLicenseAcceptance=true starting at 15.0.0). -->
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="protobuf-net" Version="3.4.30" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Trace" Version="4.0.0" />
  </ItemGroup>

</Project>
