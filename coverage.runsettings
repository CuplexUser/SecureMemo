<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage for the logic the UI reaches. WinForms forms, designer files and user controls
  are excluded (they need a UI thread and are exercised by hand), as is the vendored 7-Zip LZMA SDK.

  dotnet test -c Release -settings coverage.runsettings
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*\\SecureMemo\.dll$</ModulePath>
              </Include>
            </ModulePaths>
            <Sources>
              <Exclude>
                <Source>.*\\SecureMemo\\Form[^\\]*\.cs$</Source>
                <Source>.*\\SecureMemo\\ApplicationUpdate[^\\]*\.cs$</Source>
                <Source>.*\.Designer\.cs$</Source>
                <Source>.*\\SecureMemo\\Forms\\.*</Source>
                <Source>.*\\SecureMemo\\InputForms\\.*</Source>
                <Source>.*\\SecureMemo\\UserControls\\.*</Source>
                <Source>.*\\SecureMemo\\Utility\\(ControlHelper|GraphicsExtension)\.cs$</Source>
                <Source>.*\\SecureMemo\\Program\.cs$</Source>
                <Source>.*\\SecureMemo\\Toolkit\\Compression\\SevenZip\\.*</Source>
              </Exclude>
            </Sources>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
